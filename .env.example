# === Discord (wajib) ===
# Buat di https://discord.com/developers/applications
# Bot > Reset Token, Application ID di halaman utama aplikasi.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# ID server buat test cepat (opsional, kalau kosong command daftar global ~1 jam)
DISCORD_GUILD_ID=

# === Keamanan token Riot (wajib, JANGAN dibagikan) ===
# 64 karakter hex (32 byte). Generate dengan: npm run gen-secret
# Dipakai buat enkripsi token Riot yang disimpan di data/users.json (AES-256-GCM).
# Kalau ini diganti, semua user harus /login ulang.
SESSION_SECRET=

# === Valorant (opsional) ===
# Shard default kalau region tidak terdeteksi. Indonesia biasanya ap.
# Pilihan: ap | na | eu | kr | latam | br
DEFAULT_SHARD=ap
# Jam cek wishlist tiap pagi, WIB. Reset shop 00:00 UTC = 07:00 WIB.
CHECK_HOUR_WIB=7
CHECK_MINUTE_WIB=5
# Folder data (users.json + wishlist). Di Fly.io pakai volume /data.
DATA_DIR=./data
